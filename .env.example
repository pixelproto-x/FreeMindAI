# Copy this file to .env for local development. Never commit real API keys.
ENVIRONMENT=development
APP_PASSWORD=

# At least one provider must have a valid API key and model configured.
PROVIDER_ORDER=groq,openrouter,gemini,openai,mistral,custom
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# If this model hits a model-specific quota, try these with the same key.
# This does not replace an independent backup provider.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

CUSTOM_PROVIDER_NAME=Custom API
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_BASE_URL=

# Optional local model. Set OLLAMA_MODEL explicitly to enable Ollama.
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional reliability limits
REQUEST_TIMEOUT_SECONDS=45
MAX_OUTPUT_TOKENS=1200
RATE_LIMIT_COOLDOWN_SECONDS=90
DAILY_QUOTA_COOLDOWN_SECONDS=21600
PROVIDER_ERROR_COOLDOWN_SECONDS=60

# Leave unset for local SQLite; hosted deployment can set DATABASE_URL.
# DATABASE_URL=postgresql://user:password@host:5432/database
